{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "blockchain-api",
        "Match": { "Path": "/api/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "swagger": {
        "ClusterId": "blockchain-api",
        "Match": { "Path": "/swagger/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "openapi": {
        "ClusterId": "blockchain-api",
        "Match": { "Path": "/openapi/{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "api-health": {
        "ClusterId": "blockchain-api",
        "Match": { "Path": "/api-health/{**remainder}" },
        "Transforms": [ { "PathPattern": "/health/{**remainder}" } ]
      }
    },
    "Clusters": {
      "blockchain-api": {
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:15", "Path": "/health/ready" }
        },
        "Destinations": {
          "api": { "Address": "http://localhost:5080/" }
        }
      }
    }
  }
}
