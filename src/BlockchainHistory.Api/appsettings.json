{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BlockchainHistory": "Data Source=data/blockchain-history.db"
  },
  "BlockCypher": {
    "BaseUrl": "https://api.blockcypher.com/v1/",
    "TimeoutSeconds": 10,
    "RetryCount": 2,
    "RetryDelayMilliseconds": 500
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "RateLimiting": {
    "CapturePermitsPerHour": 20
  },
  "Polling": {
    "Enabled": false,
    "IntervalSeconds": 300
  },
  "Swagger": {
    "Enabled": true
  }
}
